              "children": [
                {
                  "type": "text",
                  "id": "vZSo7",
                  "name": "P",
                  "fill": "$v4-ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A spot VM can be reclaimed by AWS, GCP or Azure with a short warning. For most CI jobs that's fine: the job is short and you can run it again. For a deploy or a long migration it isn't.",
                  "lineHeight": 1.65,
                  "fontFamily": "Barlow",
                  "fontSize": 19,
                  "fontWeight": "500"
                },
                {
                  "type": "text",
                  "id": "WjUWC",
                  "name": "H2",
                  "fill": "$v4-ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What an interruption looks like",
                  "lineHeight": 1.05,
                  "fontFamily": "Barlow Condensed",
                  "fontSize": 42,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "KI80f",
                  "name": "P",
                  "fill": "$v4-ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "In the GitHub Actions UI the job fails with a runner-lost error. In the backmesh log you'll see the warning from the cloud, the time it arrived, and how far the job got.",
                  "lineHeight": 1.65,
                  "fontFamily": "Barlow",
                  "fontSize": 19,
                  "fontWeight": "500"
                },
