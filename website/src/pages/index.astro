---
// The landing page, in the order of julian.com's landing-page guide: navbar,
// hero, CTA, features, objections, CTA again, footer. There's no proof line
// until customers agree to be named. Short copy and real visuals; the detail
// lives in the docs. Every claim must hold for
// backmesh today.
//
// TODO(owner): link the release that opens customer installs.
// TODO(owner): add customer logos once users agree to be named.
import '../styles/fonts.css';
import '../styles/tokens.css';
import { SUMMARY } from '../about';
import * as captures from '../captures';
import AgentPrompt from '../components/AgentPrompt.astro';
import AppKey from '../components/AppKey.astro';
import Capture from '../components/Capture.astro';
import Chart, { type Row } from '../components/Chart.astro';
import CloudLanes from '../components/CloudLanes.astro';
import CueLanes from '../components/CueLanes.astro';
import HeroDiagram from '../components/HeroDiagram.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { bench } from '../bench';
import { FEATURED, seconds, times } from '../benchmarks';
import {
  CATALOG_DATE,
  GITHUB_4_CORE_PER_MIN,
  GPU,
  MINUTES,
  headline,
  per1000,
} from '../cost';

// The repo's stars, read at build time; shown from 100 up, and left out when
// GitHub doesn't answer within 5 s.
const stars: number | undefined = await fetch(
  'https://api.github.com/repos/backmesh/backmesh',
  { signal: AbortSignal.timeout(5000) },
)
  .then((r) => (r.ok ? r.json() : undefined))
  .then((r) => r?.stargazers_count)
  .catch(() => undefined);
const starCount =
  stars !== undefined && stars >= 100
    ? new Intl.NumberFormat('en', {
        notation: 'compact',
        maximumFractionDigits: 1,
      }).format(stars)
    : undefined;

const title =
  'backmesh: Free, open-source GitHub Actions runners in your AWS, GCP or Azure';
const description = `Free and open source (Apache-2.0). Self-hosted GitHub Actions runners on spot VMs in your AWS, GCP or Azure account: ${bench.headline.toLowerCase()} than GitHub-hosted runners in our benchmarks. Your cloud bills you, so its credits apply.`;
const og = new URL('/brand/og.png', Astro.site).href;
// The builds on the speed chart, each backmesh 4 vCPU inside GitHub-hosted's
// track on a shared axis in steps of 20 s; /benchmarks/ has every build.
const speed = bench.rows.filter((b) => FEATURED.includes(b.id));
const speedRows: Row[] = speed.map((b) => ({
  name: b.workload,
  ratio: `${times(b.spot.faster)} faster`,
  value: seconds(b.spot.secs),
  segments: [{ from: 0, to: b.spot.secs, kind: 'solid' }],
  track: { to: b.github.secs, value: seconds(b.github.secs) },
}));
const speedMax =
  Math.ceil(Math.max(...speed.map((b) => b.github.secs)) / 20) * 20;
const speedTicks = Array.from({ length: speedMax / 20 + 1 }, (_, i) => ({
  at: i * 20,
  label: `${i * 20} s`,
  narrow: i % 2 === 1 && i * 20 < speedMax,
}));

// GPU list prices, not a benchmark (cost.ts): backmesh's spot and on-demand
// T4 inside GitHub's T4 track, an hour.
const price = (v: number) => `$${v.toFixed(2)}`;
const cheaper = (v: number) => `${Math.round(GPU.github / v)}× cheaper`;
const gpuRows: Row[] = [
  { name: 'Spot', v: GPU.spot },
  { name: 'On demand', v: GPU.onDemand },
].map(({ name, v }) => ({
  name,
  ratio: cheaper(v),
  value: price(v),
  segments: [{ from: 0, to: v, kind: 'solid' }],
  track: { to: GPU.github, value: price(GPU.github) },
}));
const money = (v: number) => `$${Math.round(v).toLocaleString('en-US')}`;
const range = (lo: number, hi: number) => `${money(lo)}–${money(hi)}`;
const minutes = MINUTES.toLocaleString('en-US');
const caption = `GitHub's list price against spot prices on ${CATALOG_DATE}, without disks, VM boots or runners no job takes, so it's a floor; see`;

// The cost chart: GitHub's list price against each cloud's control plane
// plus its spot VMs over the cheapest and most expensive types.
const month = (per1000Usd: number) => (MINUTES / 1000) * per1000Usd;
const cents = (v: number) => `$${v.toFixed(2)}`;
const clouds = per1000.map((p) => {
  const [lo, hi] = [month(p.low), month(p.high)];
  const fixed = p.controlPlane;
  const total = range(fixed + lo, fixed + hi);
  return { ...p, lo, hi, fixed, total };
});
const costRows: Row[] = [
  {
    name: 'GitHub-hosted',
    value: money(headline.github),
    segments: [{ from: 0, to: headline.github, kind: 'ink' }],
  },
  ...clouds.map(
    (c): Row => ({
      name: `backmesh on ${c.cloud}`,
      cloud: c.cloud.toLowerCase(),
      value: c.total,
      segments: [
        { from: 0, to: c.fixed, kind: 'fixed' },
        { from: c.fixed, to: c.fixed + c.lo, kind: 'solid' },
        { from: c.fixed + c.lo, to: c.fixed + c.hi, kind: 'range' },
      ],
      note: `+ ${cents(c.bootLow)}–${cents(c.bootHigh)} per 1,000 jobs to boot their VMs, about ${seconds(c.bootS)} each`,
    }),
  ),
];
const [first, ...others] = clouds;
const fixedNote = `Control plane: about ${money(first!.fixed)} on ${first!.cloud}, ${others.map((c) => `${money(c.fixed)} on ${c.cloud}`).join(', ')}.`;
const aws = clouds.find((c) => c.cloud === 'AWS')!;

// The FAQ, shown below and in the structured data, which must match it.
const faq = [
  {
    q: 'Will backmesh work for my jobs?',
    short: 'Linux x86-64 only. Public repos with --public-repos.',
    points: [
      'No macOS, Windows or Arm runners.',
      `Each job waits for its VM to boot: about ${seconds(bench.wait)} on AWS, longer on GCP and Azure. Starting runners ahead of predicted jobs, and your agent's cue, mostly hide it.`,
      "A reclaimed spot VM fails its job; if reclaims were the run's only failures, backmesh reruns them, up to twice.",
      'Each job starts with an empty Docker layer cache.',
    ],
  },
  {
    q: 'Do you support GPUs?',
    short: 'NVIDIA T4 on AWS and Azure. GCP is coming.',
    points: [
      'GPU quotas are 0 on most new cloud accounts. Install and backmesh status show yours and name the one to request more of.',
      "At list prices, $0.18–0.53 an hour, spot to on demand, against $3.12 for GitHub's: 6–18× cheaper. We haven't compared their speed.",
      "A job's container sees the GPU with options: --gpus all, as on GitHub's runner.",
    ],
  },
  {
    q: 'Is backmesh safe?',
    short: 'Each job gets its own VM.',
    points: [
      'Jobs from every repo in the org use the same labels.',
      "Only run code you'd trust your org's members to run.",
      'Per-repo isolation is planned.',
    ],
  },
  {
    q: 'What does backmesh cost?',
    short: 'No VM while idle.',
    points: [
      "Idle: the control plane and one org's listener VM, about $86 a month on AWS, $74 on GCP, $111 on Azure for one org.",
      "Each job's VM bills from boot until the job ends.",
    ],
  },
];

// Structured data (schema.org) for search engines and AI assistants.
const site = Astro.site!.href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}#organization`,
      name: 'backmesh',
      url: site,
      logo: new URL('/brand/icon-512.png', site).href,
      email: 'luis@backmesh.com',
      sameAs: ['https://github.com/backmesh'],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'backmesh',
      url: site,
      description: SUMMARY,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux',
      license: 'https://www.apache.org/licenses/LICENSE-2.0',
      isAccessibleForFree: true,
      sameAs: ['https://github.com/backmesh/backmesh'],
      publisher: { '@id': `${site}#organization` },
      offers: {
        '@type': 'Offer',
        name: 'Free',
        price: '0',
        priceCurrency: 'USD',
        description:
          'The core features, with unlimited jobs and the cache included. Your clouds bill you for the VMs.',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(({ q, short, points }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: [short, ...points].join(' '),
        },
      })),
    },
  ],
};

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="backmesh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')}
    />
    <script is:inline>
      // The docs' stored choice (Starlight's key), else the system's.
      let stored = null;
      try {
        stored = localStorage.getItem('starlight-theme');
      } catch {}
      document.documentElement.dataset.theme =
        stored === 'light' || stored === 'dark'
          ? stored
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
    </script>
  </head>
  <body>
    <header class="wrap nav">
      <a href="/" class="logo" aria-label="backmesh home">
        <img
          class="only-light"
          src="/brand/lockup-light.svg"
          alt="backmesh"
          width="124"
          height="25"
        />
        <img
          class="only-dark"
          src="/brand/lockup-dark.svg"
          alt="backmesh"
          width="124"
          height="25"
        />
      </a>
      <nav>
        <a href="#cost">Cost</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href="/install/">Docs</a>
        <a
          id="github"
          href="https://github.com/backmesh/backmesh"
          aria-label={`Star backmesh on GitHub${starCount ? `, ${starCount} stars` : ''}`}
        >
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path>
          </svg>
          <span>Star</span>
          {starCount && <span class="count">{starCount}</span>}
        </a>
        <a
          id="discord"
          href="https://discord.backmesh.com"
          aria-label="backmesh on Discord"
          title="Discord"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
            ></path>
          </svg>
        </a>
        <button id="theme" type="button" aria-label="Switch light or dark">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 2v14a7 7 0 0 1 0-14Z"
            ></path>
          </svg>
        </button>
      </nav>
    </header>

    <main>
      <section class="wrap hero">
        <h1>{bench.headline}.</h1>
        <div class="hero-figure"><HeroDiagram /></div>
        <div class="hero-body">
          <p class="sub">
            Self-hosted GitHub Actions runners: each job runs on its own spot VM
            in your AWS, GCP or Azure account. Your cloud bills you, so your
            cloud credits apply.
          </p>
          <AgentPrompt />
          <p class="free">Free and open source (Apache-2.0), no credit card.</p>
          <div class="ctas">
            <a class="more" href="/install/">Install manually</a>
            <a class="more" href="#cost">See the costs</a>
            <a class="more" href="https://github.com/backmesh/backmesh"
              >View on GitHub</a
            >
          </div>
        </div>
      </section>

      <div class="wrap trust-wrap">
        <TrustStrip />
      </div>

      <section id="benchmarks" class="wrap section benchmarks">
        <h2>Same 4 vCPUs: backmesh vs GitHub-hosted.</h2>
        <Chart
          label={`Build time, first step to done: ${speed.map((b) => `${b.workload} ${seconds(b.spot.secs)} on backmesh 4 vCPU against ${seconds(b.github.secs)} on GitHub-hosted, ${times(b.spot.faster)} faster`).join('; ')}.`}
          max={speedMax}
          ticks={speedTicks}
          rows={speedRows}
          legendAbove={[
            { kind: 'solid', label: 'backmesh, 4 vCPUs' },
            { kind: 'track', label: 'GitHub-hosted ubuntu-latest, 4 vCPUs' },
          ]}
        />
        <p class="method"><a href="/benchmarks/">How we measured →</a></p>
      </section>

      <section id="gpu" class="wrap section benchmarks">
        <h2>NVIDIA T4 GPU runners, by the hour.</h2>
        <p class="lead">
          List prices on 2026-11-18, not a benchmark.
        </p>
        <Chart
          label={`T4 GPU runners' list price an hour: GitHub-hosted ${price(GPU.github)}; ${gpuRows.map((r) => `backmesh ${r.name.toLowerCase()} ${r.value}, ${r.ratio}`).join('; ')}.`}
          max={GPU.github}
          ticks={[
            { at: 0, label: '$0' },
            { at: 1, label: '$1' },
            { at: 2, label: '$2' },
            { at: GPU.github, label: price(GPU.github) },
          ]}
          rows={gpuRows}
          legendAbove={[
            { kind: 'solid', label: 'backmesh T4, 4 vCPUs' },
            { kind: 'track', label: 'GitHub-hosted T4, 4 vCPUs' },
          ]}
        />
        <p class="caption">AWS and Azure. Spot jobs can wait for capacity.</p>
        <p class="method"><a href="/gpu/">GPU runners →</a></p>
      </section>

      <section id="cost" class="wrap section cost">
        <h2>
          {minutes} minutes a month: {money(headline.github)} on GitHub,{' '}
          <span class="accent">{range(headline.low, headline.high)}</span> on
          backmesh.
        </h2>
        <p class="lead">
          4-vCPU Linux jobs; the range spans AWS, Azure and GCP and the VM types a job may get.
        </p>
        <Chart
          title="Compute cost a month"
          label={`Compute cost of ${minutes} minutes a month of 4-vCPU Linux jobs: ${costRows.map((r) => `${r.name} ${r.value}`).join('; ')}.`}
          max={headline.github}
          ticks={[
            { at: 0, label: '$0' },
            { at: 500, label: '$500' },
            { at: 1000, label: '$1,000' },
            { at: 1500, label: '$1,500', narrow: true },
            { at: headline.github, label: money(headline.github) },
          ]}
          rows={costRows}
          legend={[
            { kind: 'solid', label: 'Spot VMs (range across VM types)' },
            { kind: 'fixed', label: 'Control plane, fixed' },
          ]}
          note={fixedNote}
        />
        <div class="cost-foot">
          <p class="caption">
            {caption} <a href="#faq">What does backmesh cost?</a> Or work out
            your own bill with the <a href="/calculator/">cost calculator</a>, by
            cloud: <a href="/aws/">AWS</a>, <a href="/gcp/">GCP</a>,{' '}
            <a href="/azure/">Azure</a>.
          </p>
          <div
            class="receipt"
            role="img"
            aria-label={`A month of ${minutes} minutes of 4-vCPU Linux jobs: ${money(headline.github)} on GitHub-hosted runners, ${range(headline.low, headline.high)} on backmesh across AWS, Azure and GCP.`}
          >
            <div class="r-top">
              <b>Compute, one month</b>
            </div>
            <div class="r-group">
              <div class="r-head">GitHub-hosted <code>linux_4_core</code></div>
              <div class="r-line">
                <span>{minutes} min × ${GITHUB_4_CORE_PER_MIN}</span><i></i><span
                  >{money(headline.github)}.00</span
                >
              </div>
              <div class="r-total gh">
                <span>Total</span><b>{money(headline.github)}</b>
              </div>
            </div>
            <div class="r-group">
              <div class="r-head">backmesh <span>in your AWS account</span></div>
              <div class="r-line">
                <span>Spot VMs, one per job</span><i></i><span
                  >{range(aws.lo, aws.hi)}</span
                >
              </div>
              <div class="r-sub">{minutes} min, {aws.region}</div>
              <div class="r-line">
                <span>Control plane, fixed</span><i></i><span
                  >{money(aws.fixed)}</span
                >
              </div>
              <div class="r-line">
                <span>backmesh Free</span><i></i><span>$0</span>
              </div>
              <div class="r-total">
                <span>Total</span><b>{range(aws.fixed + aws.lo, aws.fixed + aws.hi)}</b>
              </div>
            </div>
            <p class="r-note">
              Spot prices on {CATALOG_DATE}, without disks or boots.
            </p>
          </div>
        </div>
      </section>

      <section id="pricing" class="wrap section pricing">
        <h2>Pricing</h2>
        <p class="lead">
          backmesh is free and open source; you pay your clouds for the VMs.
        </p>
        <ul class="plans">
          <li>
            <b>Free</b>
            <strong>$0</strong>
            <ul>
              <li>Open source, Apache-2.0</li>
              <li>Unlimited jobs</li>
              <li>Cache included</li>
              <li>No credit card required</li>
            </ul>
            <a class="more" href="/install/">Install</a>
          </li>
          <li>
            <b>Premium</b>
            <strong>Let's talk</strong>
            <ul>
              <li>Slack monitoring</li>
              <li>Logs</li>
              <li>Runtime history</li>
            </ul>
            <a class="more" href="mailto:luis@backmesh.com">Talk to us</a>
          </li>
        </ul>
      </section>

      <section class="wrap section features">
        <article>
          <div class="copy">
            <h2>Pick the cloud per workflow.</h2>
            <p>
              Each label runs in one cloud. Out of spot capacity, the next VM
              type launches, never the next cloud. Use{' '}
              <code>backmesh-ubuntu-2404-od-*</code> (on-demand) for jobs that shouldn't be interrupted.
            </p>
            <p>
              CPU and KVM runners on AWS, GCP and Azure, and NVIDIA T4{' '}
              <a href="/gpu/">GPU runners</a> on AWS and Azure.
            </p>
            <p class="links"><a class="more" href="/labels/">Learn more</a></p>
          </div>
          <CloudLanes />
        </article>

        <article>
          <div class="copy">
            <h2>Every job log ends with what it used.</h2>
            <p class="links">
              <a class="more" href="/status/#in-each-jobs-log">Learn more</a>
            </p>
          </div>
          <Capture title="Job log" code={captures.summary} />
        </article>

        <article>
          <div class="copy">
            <h2>One status for every cloud.</h2>
            <p>
              Runner VMs, queue, 24 h and 7 d job times, and month-to-date
              cost.
            </p>
            <p class="links"><a class="more" href="/status/">Learn more</a></p>
          </div>
          <Capture
            title="backmesh status"
            caption="Abridged, with illustrative numbers."
            code={captures.status}
          />
        </article>

        <article>
          <div class="copy">
            <h2>One GitHub App, and what its key can do.</h2>
            <p>
              Four permissions, its webhook off, and a key held by backmesh,
              never in your accounts. The same key works in every org that
              installs the App.
            </p>
            <p class="links">
              <a class="more" href="/security/">Learn more</a>
            </p>
          </div>
          <AppKey />
        </article>
      </section>

      <section id="cue" class="wrap section cue">
        <div class="copy">
          <h2>The boot happens before the push.</h2>
          <p>
            Your coding agent cues backmesh as its checks start, so runners
            boot while it finishes and the job starts on one that's already up.
          </p>
          <p class="links">
            <a class="more" href="/faq/">Learn more</a>
          </p>
        </div>
        <CueLanes />
      </section>

      <section id="faq" class="wrap section faq">
        <h2>Before you install</h2>
        {
          faq.map(({ q, short, points }) => (
            <details>
              <summary>
                <span class="q">
                  <b>{q}</b>
                  <span>{short}</span>
                </span>
                <span class="toggle" aria-hidden="true" />
              </summary>
              <ul>
                {points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </details>
          ))
        }
      </section>
    </main>

    <section class="band" aria-labelledby="closing">
      <div class="wrap">
        <h2 id="closing">One install. Your clouds. Your bill.</h2>
        <AgentPrompt />
        <a class="more" href="/install/">Install manually</a>
      </div>
    </section>

    <footer class="wrap foot">
      <a href="/" class="foot-logo" aria-label="backmesh home">
