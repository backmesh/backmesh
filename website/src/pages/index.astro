        <a href="/gcp/">GCP</a>
        <a href="/azure/">Azure</a>
        <a href="/calculator/">Cost calculator</a>
        <a href="/blog/tags/comparisons/">Compare</a>
        <a href="/blog/">Blog</a>
        <a href="/changelog/">Changelog</a>
