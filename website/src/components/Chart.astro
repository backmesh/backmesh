---
// A horizontal bar chart on one shared axis: each row a label, a bar of
// segments and its value at the bar's end; a hairline grid under the ticks.
// A row's `head` starts a group of rows, such as a pair to compare; a row's
// `track` draws another figure, such as GitHub's, as a pale bar behind it.
// The markup is complete; with motion allowed, the bars grow in once, the
// first time the chart scrolls into view.
import { clouds } from './clouds';

export type Segment = {
  from: number;
  to: number;
  kind: 'ink' | 'solid' | 'range' | 'fixed' | 'track';
};
export type Row = {
  name: string;
  /** A cloud's key in clouds.ts, for its mark. */
  cloud?: string;
  sub?: string;
  /** A ratio under the name, such as how much faster the row is. */
  ratio?: string;
  value: string;
  /** The figure compared against, from 0 behind the segments. */
  track?: { to: number; value: string };
  segments: Segment[];
  note?: string;
  /** A group's name and its note, such as a ratio, above its first row. */
  head?: { name: string; note: string };
};
interface Props {
  title?: string;
  label: string;
  max: number;
  ticks: { at: number; label: string; narrow?: boolean }[];
  rows: Row[];
  legend?: { kind: Segment['kind']; label: string }[];
  /** A colour key above the rows. */
  legendAbove?: { kind: Segment['kind']; label: string }[];
  note?: string;
  compact?: boolean;
}
const { title, label, max, ticks, rows, legend, legendAbove, note, compact } =
  Astro.props;
const pct = (v: number) => `${((v / max) * 100).toFixed(3)}%`;
const mark = (key?: string) => clouds.find((c) => c.key === key)?.svg;
const grouped = rows.some((r) => r.head);
---

<figure class:list={['chart', { compact }]} aria-label={label}>
  {title && <p class="title">{title}</p>}
  {
    legendAbove && (
      <ul class="legend above">
        {legendAbove.map((l) => (
          <li>
            <i class={l.kind} />
            {l.label}
          </li>
        ))}
      </ul>
    )
  }
  <div class="rows">
    <div class="grid" aria-hidden="true">
      {ticks.map((t) => <i style={`left:${pct(t.at)}`} />)}
    </div>
    {
      rows.map((row, r) => {
        const end = Math.max(...row.segments.map((s) => s.to));
        const ink = row.segments.every((s) => s.kind === 'ink');
        return (
          <>
            {row.head && (
              <p class="head">
                <span>{row.head.name}</span>
                <span class="head-note">{row.head.note}</span>
              </p>
            )}
            <div class:list={['row', { 'ink-row': ink, grouped }]}>
              <div class="name">
                {row.cloud && (
                  <span class="mark" set:html={mark(row.cloud)} aria-hidden="true" />
                )}
                <span>
                  {row.name}
                  {row.sub && <small>{row.sub}</small>}
                  {row.ratio && <small class="ratio">{row.ratio}</small>}
                </span>
                <span class="value-inline">
                  {row.value}
                  {row.track && <small> vs {row.track.value}</small>}
                </span>
              </div>
              <div class="plot">
                <div class="bar" aria-hidden="true">
                  {row.track && (
                    <i
                      class="track"
                      style={`left:0;width:${pct(row.track.to)};--delay:${r * 90}ms`}
                    />
                  )}
                  {row.segments.map((s, i) => (
                    <i
                      class={s.kind}
                      style={`left:${pct(s.from)};width:${pct(s.to - s.from)};--delay:${r * 90 + (i + (row.track ? 1 : 0)) * 140}ms`}
                    />
                  ))}
                  <span class="value" style={`left:${pct(end)}`}>
                    {row.value}
                  </span>
                  {row.track && (
                    <span
                      class="value track-value"
                      style={`left:${pct(row.track.to)}`}
                    >
                      {row.track.value}
                    </span>
                  )}
                </div>
                {row.note && (
                  <p class="note">
                    <span>{row.note}</span>
                  </p>
                )}
              </div>
            </div>
          </>
        );
      })
    }
  </div>
  <div class="axis" aria-hidden="true">
    <div>
      {
        ticks.map((t, i) => (
          <span
            class:list={{ end: i === ticks.length - 1, narrow: t.narrow }}
            style={`left:${pct(t.at)}`}
          >
            {t.label}
          </span>
        ))
      }
    </div>
  </div>
  {
    legend && (
      <ul class="legend">
        {legend.map((l) => (
          <li>
            <i class={l.kind} />
            {l.label}
          </li>
        ))}
      </ul>
    )
  }
  {note && <p class="foot">{note}</p>}
  <slot />
</figure>

<script>
  // One grow-in per chart, the first time it's seen; a chart already on
  // screen at load, or any chart under reduced motion, stays as it is.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          requestAnimationFrame(() => e.target.classList.add('shown'));
          io.unobserve(e.target);
        }
      },
      { threshold: 0, rootMargin: '0px 0px -20% 0px' },
    );
    for (const chart of document.querySelectorAll('.chart')) {
      if (chart.getBoundingClientRect().top < innerHeight * 0.8) continue;
      chart.classList.add('armed');
      io.observe(chart);
    }
  }
</script>

<style>
  .chart {
    --label: 236px;
    --gap: 24px;
    --tail: 112px;
    margin: 0;
    min-width: 0;
  }
  .chart.compact {
    --label: 148px;
    --tail: 80px;
  }
  .title {
    margin: 0 0 18px;
    font: 400 13px/1.5 var(--bm-mono);
    color: var(--bm-soft);
  }
  .rows {
    position: relative;
  }
  .grid {
    position: absolute;
    inset: 0 var(--tail) 0 calc(var(--label) + var(--gap));
    pointer-events: none;
  }
  .grid i {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--bm-hair);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr);
    column-gap: var(--gap);
    align-items: start;
    padding: 14px 0;
  }
  /* A group's rows sit closer together under its head. */
  .row.grouped {
    padding: 5px 0;
  }
  .head {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    width: var(--label);
    margin: 18px 0 4px;
    color: var(--bm-ink);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.3;
  }
  .grid + .head {
    margin-top: 0;
  }
  .head-note {
    font: 400 15px var(--bm-mono);
    color: var(--bm-accent);
  }
  .name {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 26px;
    color: var(--bm-ink);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.3;
  }
  .name small {
    display: block;
    color: var(--bm-soft);
    font-weight: 400;
    font-size: 14px;
  }
  .name .ratio {
    margin-top: 2px;
    font: 400 14px var(--bm-mono);
    color: var(--bm-accent);
  }
  .mark {
    display: flex;
    flex: none;
    color: var(--bm-ink);
  }
  .mark :global(svg) {
    width: 17px;
    height: 17px;
  }
  /* The row's value for screen readers; the bar's own label is hidden from
     them. Narrow screens show it in place of that label. */
  .value-inline {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    margin-left: auto;
    font: 400 15px var(--bm-mono);
    color: var(--bm-accent);
    white-space: nowrap;
  }
  .plot {
    position: relative;
    margin-right: var(--tail);
  }
  .bar {
    position: relative;
    height: 26px;
  }
  .bar i {
    position: absolute;
    top: 0;
    bottom: 0;
    transform-origin: left center;
  }
  /* Segments: GitHub's bar in dark blue; spot VMs solid to the cheapest type and
     lighter to the most expensive; a fixed cost hatched. */
  .ink {
    background: var(--bm-navy);
  }
  .solid {
    background: var(--bm-accent);
  }
  .range {
    background: color-mix(in srgb, var(--bm-accent) 34%, var(--bm-bg));
  }
  .track {
    background: var(--bm-track);
  }
  .fixed {
    background: repeating-linear-gradient(
      135deg,
      var(--bm-accent) 0 1.5px,
      color-mix(in srgb, var(--bm-accent) 14%, var(--bm-bg)) 1.5px 5px
    );
  }
  .value {
    position: absolute;
    top: 3px;
    padding-left: 12px;
    font: 400 15px var(--bm-mono);
    color: var(--bm-accent);
    white-space: nowrap;
  }
  .ink-row .value,
  .ink-row .value-inline {
    color: var(--bm-ink);
  }
  .track-value,
  .value-inline small {
    color: var(--bm-soft);
  }
  .value-inline small {
    display: inline;
    font-size: inherit;
  }
  .note {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--bm-soft);
  }
  /* The note sits over the grid; its own background hides the lines. */
  .note span {
    background: var(--bm-bg);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding-right: 6px;
  }
  .axis {
    display: grid;
    grid-template-columns: var(--label) minmax(0, 1fr);
    column-gap: var(--gap);
    margin-top: 6px;
  }
  .axis div {
    grid-column: 2;
    position: relative;
    height: 22px;
    margin-right: var(--tail);
    border-top: 1px solid var(--bm-line);
  }
  .axis span {
    position: absolute;
    top: 7px;
    transform: translateX(-50%);
    font: 400 12px var(--bm-mono);
    color: var(--bm-soft);
    white-space: nowrap;
  }
  .axis span:first-child {
    transform: none;
  }
  .axis span.end {
    transform: translateX(-100%);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 18px 0 0 calc(var(--label) + var(--gap));
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--bm-body);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .legend i {
    width: 28px;
    height: 12px;
  }
  .legend.above {
    margin: 0 0 18px calc(var(--label) + var(--gap));
  }
  .legend.above i {
    width: 12px;
  }
  .legend:not(.above) i.solid {
    background: linear-gradient(
      90deg,
      var(--bm-accent) 0 55%,
      color-mix(in srgb, var(--bm-accent) 34%, var(--bm-bg)) 55%
    );
  }
  .foot {
    margin: 8px 0 0 calc(var(--label) + var(--gap));
    max-width: 62ch;
    font-size: 14px;
    line-height: 1.5;
    color: var(--bm-soft);
  }
  .chart :global(figcaption) {
    margin-top: 18px;
    max-width: 62ch;
    color: var(--bm-soft);
    font-size: 15px;
    line-height: 1.55;
  }
  .chart.armed .bar i {
    transform: scaleX(0);
  }
  .chart.armed .value {
    opacity: 0;
  }
  .chart.shown .bar i {
    transform: scaleX(1);
    transition: transform 900ms cubic-bezier(0.2, 0.7, 0.2, 1) var(--delay);
  }
  .chart.shown .value {
    opacity: 1;
    transition: opacity 400ms ease 700ms;
  }
  @media (max-width: 760px) {
    .chart,
    .chart.compact {
      --label: 0px;
      --gap: 0px;
      --tail: 0px;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 10px;
      padding: 12px 0;
    }
    .name > span:not(.value-inline),
    .head span {
      background: var(--bm-bg);
    }
    .head {
      width: auto;
    }
    .row.grouped {
      padding: 4px 0;
      row-gap: 6px;
    }
    .value-inline {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
    .value {
      display: none;
    }
    .note {
      font-size: 13px;
      margin-top: 6px;
    }
    .axis {
      grid-template-columns: minmax(0, 1fr);
    }
    .axis div {
      grid-column: 1;
    }
    .axis span.narrow {
      display: none;
    }
    .legend,
    .foot {
      margin-left: 0;
    }
  }
</style>
