// The Cloudflare Worker that serves the site; .github/workflows/website.yml
// deploys it.
{
  "name": "backmesh-website",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "backmesh.com", "custom_domain": true },
    { "pattern": "www.backmesh.com", "custom_domain": true },
    { "pattern": "llmcomp.backmesh.com", "custom_domain": true },
  ],
  "workers_dev": false,
}
