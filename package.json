    "@types/node": "^22.20.5",
    "bun": "1.4.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@hpke/core": "^1.10.0",
    "@octokit/rest": "^22.0.1",
    "@orpc/client": "^1.15.0",
    "@orpc/contract": "^1.15.0",
