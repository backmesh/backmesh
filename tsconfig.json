{
	"compilerOptions": {
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["esnext"],
		"strict": true,
		"types": ["@cloudflare/workers-types"],
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": false,
		"moduleDetection": "force",
		"isolatedModules": true,
	},
	"exclude": ["node_modules", "dist", "scripts", "test"],
	"include": ["worker-configuration.d.ts", "src/**/*.ts"]
}
